          <dc:Bounds x="969.7" y="235" width="20.6" height="25"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_Flow_5" bpmnElement="Flow_5">
        <di:waypoint x="926" y="296"/>
        <di:waypoint x="926" y="318"/>
        <di:waypoint x="900" y="318"/>
        <di:waypoint x="900" y="335"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="949.7" y="309" width="20.6" height="25"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_Flow_6" bpmnElement="Flow_6">
        <di:waypoint x="995" y="368"/>
