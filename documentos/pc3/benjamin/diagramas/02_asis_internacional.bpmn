        <di:waypoint x="1040" y="354"/>
        <di:waypoint x="1080" y="354"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_Flow_7" bpmnElement="Flow_7">
        <di:waypoint x="1240" y="272"/>
