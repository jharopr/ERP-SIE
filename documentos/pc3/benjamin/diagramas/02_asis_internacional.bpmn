      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_Assoc_0" bpmnElement="Assoc_0">
        <di:waypoint x="530" y="340"/>
        <di:waypoint x="530" y="315"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
