        <di:waypoint x="1330" y="528"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_Flow_8" bpmnElement="Flow_8">
        <di:waypoint x="1535" y="528"/>
        <di:waypoint x="1560" y="528"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_Message_0" bpmnElement="Message_0">
        <di:waypoint x="1210" y="325"/>
        <di:waypoint x="1210" y="700"/>
        <di:waypoint x="405" y="700"/>
        <di:waypoint x="405" y="735"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="552.0" y="671" width="206.0" height="25"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_Message_1" bpmnElement="Message_1">
        <di:waypoint x="1450" y="735"/>
        <di:waypoint x="1450" y="575"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1422.75" y="631" width="154.5" height="25"/>
