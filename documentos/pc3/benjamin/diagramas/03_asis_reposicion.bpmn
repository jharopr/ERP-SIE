<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_03_asis_reposicion" targetNamespace="https://github.com/jharopr/ERP-SIE/pc3/benjamin">
  <bpmn:process id="Process_MYS" name="Figura 3  Reposición interna AS IS" isExecutable="false">
    <bpmn:laneSet id="LaneSet_MYS">
      <bpmn:lane id="Lane_Tienda" name="Encargado de tienda">
        <bpmn:flowNodeRef>Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Anotar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Recibir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Almacen" name="Almacenero fijo">
        <bpmn:flowNodeRef>Revisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Disponible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Preparar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Familia" name="Gestión familiar">
        <bpmn:flowNodeRef>Coordinar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pendiente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FinPendiente</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Inicio" name="Necesidad en tienda">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Anotar" name="Anotar necesidad en cuaderno">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Coordinar" name="Coordinar reposición">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Revisar" name="Revisar mercadería para preparar">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Disponible" name="¿Se puede reponer?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Preparar" name="Preparar mercadería y coordinar traslado">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Recibir" name="Recibir en tienda">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Fin" name="Recibida">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Pendiente" name="Mantener necesidad para decisión familiar">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="FinPendiente" name="Atención por resolver">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="Inicio" targetRef="Anotar"/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Anotar" targetRef="Coordinar"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Coordinar" targetRef="Revisar"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Revisar" targetRef="Disponible"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Disponible" targetRef="Preparar" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Sí</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Disponible" targetRef="Pendiente" name="No">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">No</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Pendiente" targetRef="FinPendiente"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Preparar" targetRef="Recibir"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Recibir" targetRef="Fin"/>
    <bpmn:dataObject id="Cuaderno_object"/>
    <bpmn:dataObjectReference id="Cuaderno" name="Cuaderno de necesidades" dataObjectRef="Cuaderno_object"/>
    <bpmn:association id="Assoc_0" sourceRef="Cuaderno" targetRef="Anotar" associationDirection="None"/>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="Participant_MYS" name="Importaciones MYS Hermanos S A C" processRef="Process_MYS"/>
    <bpmn:participant id="Pool_Transporte" name="Transporte externo · mayoritariamente inDrive"/>
    <bpmn:messageFlow id="Message_0" sourceRef="Preparar" targetRef="Pool_Transporte" name="Coordinación del traslado"/>
    <bpmn:messageFlow id="Message_1" sourceRef="Pool_Transporte" targetRef="Recibir" name="Aviso / entrega"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_03_asis_reposicion">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collaboration">
      <bpmndi:BPMNShape id="DI_MYS" bpmnElement="Participant_MYS" isHorizontal="true">
        <dc:Bounds x="40" y="150" width="1580" height="565"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Lane_Tienda" bpmnElement="Lane_Tienda" isHorizontal="true">
        <dc:Bounds x="40" y="150" width="1580" height="180"/>
