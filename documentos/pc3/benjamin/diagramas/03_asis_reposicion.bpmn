      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Lane_Familia" bpmnElement="Lane_Familia" isHorizontal="true">
        <dc:Bounds x="40" y="535" width="1580" height="180"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Pool_Transporte" bpmnElement="Pool_Transporte" isHorizontal="true">
        <dc:Bounds x="40" y="770" width="1580" height="70"/>
