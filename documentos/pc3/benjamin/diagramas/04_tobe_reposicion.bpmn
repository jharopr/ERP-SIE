<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_04_tobe_reposicion" targetNamespace="https://github.com/jharopr/ERP-SIE/pc3/benjamin">
  <bpmn:process id="Process_MYS" name="Figura 4  Reposición TO BE con trazabilidad" isExecutable="false">
    <bpmn:laneSet id="LaneSet_MYS">
      <bpmn:lane id="Lane_Tienda" name="Encargado de tienda">
        <bpmn:flowNodeRef>Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Solicitar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Referencia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Aclarar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Recibir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Conforme</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Cerrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Almacen" name="Almacenero fijo">
        <bpmn:flowNodeRef>Verificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Hay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Preparar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Despachar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Diferencia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FinDiferencia</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Familia" name="Propietarios">
        <bpmn:flowNodeRef>Faltante</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Autorizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Compra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FinCompra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FinNoCompra</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Inicio" name="Necesidad identificada">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Solicitar" name="Crear solicitud ID, SKU, cantidad y fecha">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Referencia" name="¿Referencia compatible?">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Aclarar" name="Aclarar referencia y compatibilidad">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Verificar" name="Verificar existencia y saldo por ubicación">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Hay" name="¿Saldo suficiente?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Preparar" name="Preparar y confirmar referencias / cantidades">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Despachar" name="Registrar salida y tránsito">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Recibir" name="Cotejar y registrar recepción">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Conforme" name="¿Coincide?">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Cerrar" name="Cerrar y actualizar saldos">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Fin" name="Cerrada">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Diferencia" name="Registrar diferencia y conciliar con tienda">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="FinDiferencia" name="Por conciliar">
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Faltante" name="Registrar saldo no atendido y evaluar compra">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Autorizar" name="¿Autorizar compra?">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="Compra" name="Gestionar compra y seguimiento de recepción">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:startEvent id="Compra_start"/>
      <bpmn:task id="Compra_detail" name="Evaluación humana y seguimiento según sección 5B"/>
      <bpmn:endEvent id="Compra_end"/>
      <bpmn:sequenceFlow id="Compra_f1" sourceRef="Compra_start" targetRef="Compra_detail"/>
      <bpmn:sequenceFlow id="Compra_f2" sourceRef="Compra_detail" targetRef="Compra_end"/>
    </bpmn:subProcess>
    <bpmn:endEvent id="FinCompra" name="Necesidad en seguimiento">
      <bpmn:incoming>Flow_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="FinNoCompra" name="Sin compra">
      <bpmn:incoming>Flow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="Inicio" targetRef="Solicitar"/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Solicitar" targetRef="Referencia"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Referencia" targetRef="Aclarar" name="No / duda">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">No / duda</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Aclarar" targetRef="Solicitar"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Referencia" targetRef="Verificar" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Sí</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Verificar" targetRef="Hay"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Hay" targetRef="Preparar" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Sí</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Preparar" targetRef="Despachar"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Despachar" targetRef="Recibir"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Recibir" targetRef="Conforme"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Conforme" targetRef="Cerrar" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Sí</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Cerrar" targetRef="Fin"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Conforme" targetRef="Diferencia" name="No">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">No</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Diferencia" targetRef="FinDiferencia"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Hay" targetRef="Faltante" name="No / saldo">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">No / saldo</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Faltante" targetRef="Autorizar"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Autorizar" targetRef="Compra" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Sí</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Compra" targetRef="FinCompra"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Autorizar" targetRef="FinNoCompra" name="No">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">No</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:dataObject id="Registro_object"/>
    <bpmn:dataObjectReference id="Registro" name="ID + movimientos + fechas" dataObjectRef="Registro_object"/>
    <bpmn:association id="Assoc_0" sourceRef="Registro" targetRef="Despachar" associationDirection="None"/>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="Participant_MYS" name="Importaciones MYS Hermanos S A C" processRef="Process_MYS"/>
    <bpmn:participant id="Pool_Transporte" name="Transportista externo · confirmación de recojo y entrega"/>
    <bpmn:messageFlow id="Message_0" sourceRef="Despachar" targetRef="Pool_Transporte" name="Salida / identificación del traslado"/>
    <bpmn:messageFlow id="Message_1" sourceRef="Pool_Transporte" targetRef="Recibir" name="Entrega / constancia"/>
  </bpmn:collaboration>
