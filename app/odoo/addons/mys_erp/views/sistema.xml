<odoo>
    <record id="action_workspace" model="ir.actions.client"><field name="name">Vista general MYS</field><field name="tag">mys.workspace</field></record>
    <record id="action_agent" model="ir.actions.client"><field name="name">Agente SIE</field><field name="tag">mys.workspace</field><field name="params" eval="{'page': 'agent'}"/></record>
    <record id="action_trace" model="ir.actions.client"><field name="name">Trazabilidad</field><field name="tag">mys.workspace</field><field name="params" eval="{'page': 'trace'}"/></record>
    <record id="action_leads" model="ir.actions.act_window">
        <field name="name">Leads</field><field name="res_model">crm.lead</field><field name="view_mode">list,form</field>
        <field name="domain">[('type', '=', 'lead')]</field><field name="context">{'default_type': 'lead'}</field>
    </record>
    <record id="action_opportunities" model="ir.actions.act_window">
        <field name="name">CRM / Oportunidades</field><field name="res_model">crm.lead</field><field name="view_mode">kanban,list,form</field>
        <field name="domain">[('type', '=', 'opportunity')]</field><field name="context">{'default_type': 'opportunity', 'mys_commercial_pipeline': True}</field>
    </record>
    <record id="view_stock_list" model="ir.ui.view">
        <field name="name">mys.inventory.list</field><field name="model">product.template</field>
        <field name="arch" type="xml"><list create="false" edit="false" delete="false" default_order="mys_prioridad_demo,id">
            <field name="default_code"/><field name="name"/><field name="categ_id"/><field name="qty_available" string="Físico"/>
            <field name="virtual_available" string="Previsto"/><field name="mys_disponible" string="Disponible"/>
        </list></field>
    </record>
    <record id="action_inventory" model="ir.actions.act_window">
        <field name="name">Inventario</field><field name="res_model">product.template</field><field name="view_mode">list,form</field>
        <field name="view_id" ref="view_stock_list"/><field name="domain">[('is_storable', '=', True)]</field>
    </record>
    <record id="action_evaluations" model="ir.actions.act_window">
        <field name="name">Evaluación comercial</field><field name="res_model">mys.evaluation</field><field name="view_mode">list,form</field>
    </record>
    <record id="view_evaluation_list" model="ir.ui.view">
        <field name="name">mys.evaluation.list</field><field name="model">mys.evaluation</field>
        <field name="arch" type="xml"><list create="false" edit="false" delete="false" decoration-success="status == 'ACEPTADA'" decoration-warning="status in ['PENDIENTE', 'PROMESA_CONDICIONADA']" decoration-danger="status == 'RECHAZADA'">
            <field name="request_id"/><field name="order_id"/><field name="user_id"/><field name="status"/><field name="code"/><field name="correlation_id"/>
        </list></field>
    </record>
    <record id="view_evaluation_form" model="ir.ui.view">
        <field name="name">mys.evaluation.form</field><field name="model">mys.evaluation</field>
        <field name="arch" type="xml"><form create="false" edit="false" delete="false">
            <header><button name="action_request_decision" type="object" string="Solicitar decisión del dueño" class="btn-primary" groups="mys_erp.group_mys_seller" invisible="code not in ['DESCUENTO_SIN_APROBACION', 'DISPONIBILIDAD_PARCIAL']"/>
                <button name="action_trace" type="object" string="Ver trazabilidad"/></header>
            <sheet><div class="alert alert-info">Evaluación previa al pedido. Ningún resultado crea pedidos, reservas ni fechas prometidas.</div>
                <group><group><field name="request_id"/><field name="order_id"/><field name="user_id"/><field name="correlation_id"/></group>
                    <group><field name="status"/><field name="code"/><field name="company_id" groups="base.group_multi_company"/></group></group>
                <group><field name="message"/><field name="required_action"/></group>
                <notebook><page string="Condiciones y respuesta"><field name="response_json"/></page>
                    <page string="Seguimiento del dueño"><field name="decision_ids" readonly="1"/></page></notebook>
            </sheet></form></field>
    </record>
    <record id="action_decisions" model="ir.actions.act_window">
        <field name="name">Decisiones del dueño</field><field name="res_model">mys.decision</field><field name="view_mode">list,form</field>
    </record>
    <record id="view_decision_list" model="ir.ui.view">
        <field name="name">mys.decision.list</field><field name="model">mys.decision</field>
        <field name="arch" type="xml"><list create="false" delete="false" decoration-warning="state == 'ESPERANDO_DECISION'">
            <field name="escalation_id"/><field name="tipo"/><field name="order_id"/><field name="partner_id"/><field name="user_id"/><field name="descuento_max"/><field name="total"/>
            <field name="state"/><field name="decision"/><field name="deadline"/>
        </list></field>
    </record>
    <record id="view_decision_form" model="ir.ui.view">
        <field name="name">mys.decision.form</field><field name="model">mys.decision</field>
        <field name="arch" type="xml"><form create="false" delete="false">
            <header>
                <button name="action_approve" type="object" string="Aprobar descuento" class="btn-primary" groups="mys_erp.group_mys_manager" invisible="state != 'ESPERANDO_DECISION' or tipo != 'DESCUENTO'"/>
                <button name="action_reject" type="object" string="Rechazar descuento" groups="mys_erp.group_mys_manager" invisible="state != 'ESPERANDO_DECISION' or tipo != 'DESCUENTO'"/>
                <button name="action_partial" type="object" string="Ofrecer parcial" groups="mys_erp.group_mys_manager" invisible="state != 'ESPERANDO_DECISION' or tipo != 'REPOSICION'"/>
                <button name="action_replenish" type="object" string="Evaluar reposición" groups="mys_erp.group_mys_manager" invisible="state != 'ESPERANDO_DECISION' or tipo != 'REPOSICION'"/>
                <button name="action_discard" type="object" string="Descartar" groups="mys_erp.group_mys_manager" invisible="state != 'ESPERANDO_DECISION' or tipo != 'REPOSICION'"/>
            </header>
            <sheet><div class="alert alert-info">Solo el dueño decide. Un descuento aprobado se aplica a una nueva versión con el mismo total; requiere nueva aceptación del cliente y evaluación.</div>
                <group><group><field name="escalation_id"/><field name="evaluation_id"/><field name="order_id"/><field name="user_id"/><field name="tipo"/></group>
                    <group><field name="state"/><field name="total"/><field name="target_version"/><field name="deadline"/><field name="company_id" groups="base.group_multi_company"/></group></group>
                <separator string="Detalle de la cotización"/>
                <div class="alert alert-warning" role="alert" invisible="tipo != 'DESCUENTO' or descuento_max &lt;= tope_vendedor">
                    El vendedor pidió <field name="descuento_max" class="fw-bold" nolabel="1"/> % de descuento; su tope es <field name="tope_vendedor" nolabel="1"/> %. Por eso necesita su decisión.
                </div>
                <group><group><field name="partner_id"/><field name="unidades"/></group>
                    <group><field name="ahorro_cliente"/><field name="amount_total" class="fw-bold"/><field name="currency_id" invisible="1"/></group></group>
                <separator string="Perfil del cliente"/>
                <group><group>
                        <field name="cliente_nivel" widget="badge"
                               decoration-success="cliente_nivel == 'mayorista'" decoration-info="cliente_nivel == 'frecuente'"
                               decoration-warning="cliente_nivel == 'ocasional'" decoration-muted="cliente_nivel == 'nuevo'"/>
                        <field name="cliente_motivo"/>
                    </group><group>
                        <field name="cliente_compras"/><field name="cliente_monto"/>
                        <field name="cliente_descuento_prom"/><field name="cliente_conversion"/>
                    </group></group>
                <field name="order_line_ids" readonly="1" nolabel="1">
                    <list create="false" delete="false" decoration-danger="discount &gt; 5">
                        <field name="product_id" string="Producto"/><field name="product_uom_qty" string="Cantidad"/>
                        <field name="price_unit" string="Precio unitario"/><field name="discount" string="Descuento %"/>
                        <field name="price_subtotal" string="Subtotal" sum="Total"/>
                    </list>
                </field>
                <group><field name="motivo" placeholder="Motivo de la decisión (obligatorio)" readonly="state != 'ESPERANDO_DECISION'" groups="mys_erp.group_mys_manager"/>
                    <field name="decision"/><field name="approver_id"/><field name="new_order_id"/></group>
            </sheet><chatter/></form></field>
    </record>
    <record id="sale_form_mys" model="ir.ui.view">
        <field name="name">sale.order.mys.rules</field><field name="model">sale.order</field><field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_mys_send" type="object" string="1. Preparar / enviar" groups="mys_erp.group_mys_seller" invisible="mys_locked or state not in ['draft', 'sent']"/>
                <button name="action_mys_accept" type="object" string="2. Registrar aceptación" groups="mys_erp.group_mys_seller" invisible="mys_locked or state != 'sent'"/>
                <button name="action_mys_evaluate" type="object" string="3. Evaluar reglas" class="btn-primary" groups="mys_erp.group_mys_seller" invisible="not mys_acceptance_id or state != 'sent'"/>
                <button name="action_mys_new_version" type="object" string="Nueva versión" groups="mys_erp.group_mys_seller" invisible="not mys_quotation_id"/>
                <field name="mys_locked" invisible="1"/>
            </xpath>
            <xpath expr="//sheet/*[1]" position="before">
                <field name="mys_supera_tope" invisible="1"/><field name="mys_approval_hash" invisible="1"/>
                <div class="alert alert-warning mb-3" role="alert" invisible="not mys_supera_tope or mys_approval_hash">
                    <i class="fa fa-exclamation-triangle me-1"/> <b>Esta oferta pasa el tope del vendedor.</b>
                    Hay un descuento de <field name="mys_descuento_max" nolabel="1" class="fw-bold"/> % y el tope es
                    <field name="mys_tope_vendedor" nolabel="1"/> %. Al evaluarla se pedirá la decisión del gerente.
                    Las líneas en rojo son las que superan el tope.
                </div>
                <div class="alert alert-success mb-3" role="status" invisible="not mys_approval_hash">
                    <i class="fa fa-check-circle me-1"/> <b>Descuento aprobado por el gerente</b> para esta versión y este total.
                    Envíala al cliente, registra su aceptación y evalúa.
                </div>
            </xpath>
            <xpath expr="//field[@name='order_line']/list" position="attributes">
                <attribute name="decoration-danger">discount &gt; 5</attribute>
            </xpath>
            <xpath expr="(//button[@name='action_confirm'])[1]" position="attributes"><attribute name="invisible">True</attribute></xpath>
            <xpath expr="(//button[@name='action_confirm'])[2]" position="attributes"><attribute name="invisible">True</attribute></xpath>
            <xpath expr="//notebook" position="inside"><page name="mys_rules" string="Reglas comerciales SIE">
                <div class="alert alert-info">Descuento de hasta 5 %: evaluación del vendedor. Mayor al 5 %: requiere decisión del dueño para la versión y total exactos. La evaluación no confirma un pedido.</div>
                <group><group><field name="opportunity_id"/><field name="mys_quotation_id"/><field name="mys_version"/><field name="mys_acceptance_id"/></group>
                    <group><field name="mys_status"/><field name="mys_request_id"/><field name="mys_correlation_id"/></group></group>
                <field name="mys_evaluation_ids" readonly="1"/><field name="mys_response" readonly="1"/>
            </page></xpath>
        </field>
    </record>
    <menuitem id="menu_mys_home" name="Vista general" parent="menu_mys" action="action_workspace" sequence="1"/>
    <menuitem id="menu_mys_leads" name="Leads" parent="menu_mys" action="action_leads" sequence="21"/>
    <record id="menu_mys_leads" model="ir.ui.menu"><field name="active" eval="True"/></record>
    <menuitem id="menu_mys_inventory" name="Inventario" parent="menu_mys" action="action_inventory" sequence="35"/>
    <menuitem id="menu_mys_evaluations" name="Evaluación comercial" parent="menu_mys" action="action_evaluations" sequence="50"/>
    <menuitem id="menu_mys_decisions" name="Decisiones del dueño" parent="menu_mys" action="action_decisions" sequence="60"/>
    <menuitem id="menu_mys_trace" name="Trazabilidad" parent="menu_mys" action="action_trace" sequence="70"/>
    <menuitem id="menu_mys_agent" name="Agente SIE" parent="menu_mys" action="action_agent" sequence="80"/>
</odoo>
