<odoo>
    <record id="action_catalogo_mys" model="ir.actions.act_window">
        <field name="name">Catálogo MYS</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_catalogo_mys_list"/>
        <field name="domain">[('mys_catalogo', '=', True)]</field>
    </record>
    <record id="action_contactos_mys" model="ir.actions.act_window">
        <field name="name">Contactos</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_contactos_mys_search"/>
        <field name="domain">[('mys_demo', '=', True), ('supplier_rank', '=', 0)]</field>
        <field name="context">{'default_mys_demo': True, 'default_customer_rank': 1}</field>
    </record>
    <record id="action_contactos_mys_kanban" model="ir.actions.act_window.view">
        <field name="sequence">1</field><field name="view_mode">kanban</field>
        <field name="view_id" ref="view_contactos_mys_kanban"/><field name="act_window_id" ref="action_contactos_mys"/>
    </record>
    <record id="action_contactos_mys_list" model="ir.actions.act_window.view">
        <field name="sequence">2</field><field name="view_mode">list</field>
        <field name="view_id" ref="view_contactos_mys_list"/><field name="act_window_id" ref="action_contactos_mys"/>
    </record>
    <record id="action_oportunidades_mys" model="ir.actions.act_window">
        <field name="name">Oportunidades MYS</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('type', '=', 'opportunity')]</field>
    </record>
    <record id="action_cotizaciones_mys" model="ir.actions.act_window">
        <field name="name">Cotizaciones MYS</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('client_order_ref', '=like', 'COT-%')]</field>
    </record>
    <menuitem id="menu_mys" name="MYS Hermanos" sequence="5" groups="base.group_user"/>
    <menuitem id="menu_mys_catalogo" name="Catálogo de productos" parent="menu_mys" action="action_catalogo_mys" sequence="10"/>
    <menuitem id="menu_mys_clientes" name="Clientes" parent="menu_mys" action="action_contactos_mys" sequence="20"/>
    <menuitem id="menu_mys_oportunidades" name="Oportunidades" parent="menu_mys" action="action_oportunidades_mys" sequence="30"/>
    <menuitem id="menu_mys_cotizaciones" name="Cotizaciones y versiones" parent="menu_mys" action="action_cotizaciones_mys" sequence="40"/>
</odoo>
