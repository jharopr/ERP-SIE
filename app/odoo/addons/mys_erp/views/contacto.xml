<odoo>
    <record id="view_contacto_mys" model="ir.ui.view">
        <field name="name">res.partner.mys.demo</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="MYS" name="mys_demo">
                    <group><field name="ref"/><field name="mys_demo"/><field name="mys_segmento"/><field name="mys_identidad_revisada"/></group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
