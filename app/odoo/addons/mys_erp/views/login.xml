<odoo>
    <template id="login_layout_mys" inherit_id="web.login_layout" name="Acceso MYS">
        <xpath expr="//t[@t-set='body_classname']" position="attributes"><attribute name="t-value">'bg-100 mys_login'</attribute></xpath>
        <xpath expr="//div[hasclass('card-body')]/div[1]" position="replace">
            <div class="mys_login_brand"><img src="/mys_erp/static/img/ms-power.svg" alt="MS Power Audio"/>
                <p>IMPORTACIONES MYS HERMANOS</p><h1>Tu gestión, conectada.</h1><span>Contactos · CRM · Inventario · Ventas · Agente SIE</span></div>
        </xpath>
    </template>
    <template id="login_mys" inherit_id="web.login" name="Usuario MYS">
        <xpath expr="//label[@for='login']" position="replace"><label for="login" class="form-label">Usuario</label></xpath>
        <xpath expr="//input[@name='login']" position="attributes"><attribute name="placeholder">Tu usuario MYS</attribute></xpath>
    </template>
</odoo>
