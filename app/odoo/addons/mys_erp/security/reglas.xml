<odoo>
    <record id="rule_lead_products_company" model="ir.rule">
        <field name="name">Productos del lead: compañía</field><field name="model_id" ref="model_mys_lead_product"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_lead_products_seller" model="ir.rule">
        <field name="name">Vendedor: productos de sus leads</field><field name="model_id" ref="model_mys_lead_product"/>
        <field name="groups" eval="[(4, ref('mys_erp.group_mys_seller'))]"/>
        <field name="domain_force">['|', ('lead_id.user_id', '=', user.id), ('lead_id.user_id', '=', False)]</field>
    </record>
    <record id="rule_lead_products_manager" model="ir.rule">
        <field name="name">Gerente: productos de los leads</field><field name="model_id" ref="model_mys_lead_product"/>
        <field name="groups" eval="[(4, ref('mys_erp.group_mys_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_agente_partner" model="ir.rule">
        <field name="name">SIE: contactos de prueba de la compañía</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[(4, ref('mys_erp.group_agente_lectura'))]"/>
        <field name="domain_force">[('mys_demo', '=', True), '|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_agente_sale" model="ir.rule">
        <field name="name">SIE: cotizaciones comerciales MYS</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="groups" eval="[(4, ref('mys_erp.group_agente_lectura'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids), ('client_order_ref', '=like', 'COT-%')]</field>
    </record>
    <record id="rule_agente_lead" model="ir.rule">
        <field name="name">SIE: oportunidades MYS</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="groups" eval="[(4, ref('mys_erp.group_agente_lectura'))]"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_agente_quant" model="ir.rule">
        <field name="name">SIE: disponibilidad de la compañía</field>
        <field name="model_id" ref="stock.model_stock_quant"/>
        <field name="groups" eval="[(4, ref('mys_erp.group_agente_lectura'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids), ('location_id.usage', '=', 'internal')]</field>
    </record>
</odoo>
