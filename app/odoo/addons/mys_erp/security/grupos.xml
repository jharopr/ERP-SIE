<odoo>
    <record id="group_mys_seller" model="res.groups">
        <field name="name">MYS / Vendedor</field>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman')), (4, ref('base.group_partner_manager')), (4, ref('crm.group_use_lead')), (4, ref('sale.group_discount_per_so_line'))]"/>
    </record>
    <record id="group_mys_manager" model="res.groups">
        <field name="name">MYS / Dueño y gerencia</field>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_manager')), (4, ref('stock.group_stock_manager')), (4, ref('crm.group_use_lead'))]"/>
    </record>
    <!-- Sin implied_ids de usuario interno: los permisos Odoo son aditivos.
         El usuario técnico recibe exclusivamente las ACL de lectura siguientes. -->
    <record id="group_agente_lectura" model="res.groups">
        <field name="name">MYS / Integración SIE solo lectura</field>
    </record>
</odoo>
