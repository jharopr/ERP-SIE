# Copie este archivo a .env y reemplace cada «cambiar-esto».  .env NO se sube al repositorio.
# Todas las claves son locales de la demo; no use contraseñas reales ni reutilizadas.

# --- PostgreSQL (solo red interna de Docker) ---
POSTGRES_USER=odoo
POSTGRES_PASSWORD=cambiar-esto-postgres

# --- Odoo 18 Community ---
# Clave maestra del gestor de bases (la usa el seed para crear la base mys_demo).
ODOO_MASTER_PASSWORD=cambiar-esto-maestra
ODOO_DB=mys_demo
# Usuario administrador que el seed crea en mys_demo. El servicio lee con sie-lectura.
ODOO_USER=admin
ODOO_PASSWORD=admin
# Idioma de la base (es_PE; si falla, use en_US).
ODOO_IDIOMA=es_PE

# --- Compuerta (FastAPI) ---
# Tres tokens DISTINTOS y largos. Genérelos con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# VENTAS: compatibilidad con casos técnicos históricos. No puede aprobar.
TOKEN_VENTAS=cambiar-esto-ventas
# GERENCIA: casos técnicos históricos; la interfaz actual decide con sesión Odoo firmada.
TOKEN_GERENCIA=cambiar-esto-gerencia
# ADMIN: reinicio de la demo y bandera de caída simulada.
TOKEN_ADMIN=cambiar-esto-admin-token
# Hora de cierre de la vigencia de las cotizaciones (hora Lima). El escenario usa 18:00;
# súbala (p. ej. 23:00) si ensaya de noche.
COTIZACION_HORA_CIERRE=23:59

# --- n8n ---
# Versión fija de la imagen (ver README, sección «Versiones verificadas»).
N8N_VERSION=2.46.7
# Clave de cifrado de credenciales de n8n (cadena aleatoria larga). No la cambie después de crear credenciales.
N8N_ENCRYPTION_KEY=cambiar-esto-cifrado-n8n

# --- Modelo de lenguaje del chat integrado ---
# Proveedor por defecto: Google Gemini (credencial «Google Gemini(PaLM) Api» en n8n).
# Opcional: si la define, scripts/importar_n8n.py crea la credencial de Gemini en n8n.
# Déjela vacía para deshabilitar el chat. Las reglas y módulos Odoo funcionan sin modelo.
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-3.5-flash-lite

# --- Aviso al dueño (correo que envía Odoo al crear una «Decisión del dueño») ---
# Por defecto llega al buzón local Mailpit: http://localhost:8025 (sin cuenta).
# Para un correo real con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SEGURO=true,
# SMTP_USUARIO=<cuenta>@gmail.com, SMTP_CLAVE=<contraseña de aplicación>. Luego: python scripts/iniciar.py
CORREO_DUENO=dueno@mys-demo.local
CORREO_REMITENTE=agente-sie@mys-demo.local
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SEGURO=false
SMTP_USUARIO=
SMTP_CLAVE=

# --- Puertos publicados en el equipo anfitrión ---
ODOO_PORT=8069
COMPUERTA_PORT=8000
N8N_PORT=5678
MAILPIT_PORT=8025

# --- Plataforma integrada app/ ---
APP_PORT=8088
# Cuenta técnica de Odoo con ACL de lectura, distinta del administrador del seed.
ODOO_READER_USER=sie-lectura
ODOO_READER_PASSWORD=cambiar-esto-lector
# Acceso único Odoo: contraseñas humanas iguales a sus usuarios de demostración.
ODOO_SELLER_PASSWORD=vendedor01
ODOO_OWNER_PASSWORD=gerente
# Propietario del editor n8n; se usa solo al inicializar una instancia nueva.
N8N_OWNER_EMAIL=admin@mys.local
N8N_OWNER_PASSWORD=cambiar-esto-editor

# Puente privado de sesión Odoo y chat. configurar.py genera valores distintos.
TOKEN_ODOO=cambiar-esto-puente
TOKEN_AGENTE=cambiar-esto-agente
ODOO_BRIDGE_SECRET=cambiar-esto-firma
N8N_WEBHOOK_SECRET=cambiar-esto-webhook
