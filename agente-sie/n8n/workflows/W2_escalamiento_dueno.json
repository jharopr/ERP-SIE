      "parameters": {
        "jsCode": "const e = $input.first().json;\nif (!e.escalation_id) {\n  return [{ json: { estado: 'NO_ESCALADO', motivo: e.detail || e, siguiente_paso: 'Revisar la solicitud; no se notificó al dueño.' } }];\n}\nconst opciones = e.tipo === 'DESCUENTO' ? ['APROBADA', 'RECHAZADA']\n  : ['OFRECER_PARCIAL', 'EVALUAR_REPOSICION', 'DESCARTAR'];\nconst base = `http://localhost:5678/form/decision-dueno?escalation_id=${e.escalation_id}`;\n// Un enlace por decisión: el formulario abre con ESC y decisión ya marcados; el dueño solo pulsa Submit.\nconst enlaces = Object.fromEntries(opciones.map(o => [o, `${base}&decision=${o}`]));\nreturn [{ json: {\n  estado: 'ESPERANDO_DECISION_DEL_DUENO', escalation_id: e.escalation_id, tipo: e.tipo,\n  destinatario: e.destinatario, signal_id: e.signal_id, aprobacion_aplicaria_a_version: e.version_aprobacion,\n  total_verificado: e.total, plazo_hasta: e.plazo_hasta, enlaces_un_clic_para_el_dueno: enlaces,\n  nota: 'Si no hay respuesta en 10 minutos: sin decisión, la oportunidad queda en seguimiento.'\n} }];"
      },
