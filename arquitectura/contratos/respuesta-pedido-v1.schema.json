{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mys:pc2:respuesta-pedido:1.1",
  "title": "I03/I08 Decisión y retorno a CRM; perfil local sin confirmación",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "correlation_id",
    "quotation_id",
    "quotation_version",
    "status",
    "code",
    "message",
    "responsible_role",
    "required_action",
    "total",
    "currency",
    "order_id",
    "conditions",
    "response_id",
    "order_state",
    "follow_up_state",
    "attention_due_at"
  ],
  "properties": {
    "contract_version": {
      "const": "1.1"
    },
    "request_id": {
      "$ref": "#/$defs/nullableIdentifier"
    },
    "correlation_id": {
      "$ref": "#/$defs/nullableIdentifier"
    },
    "quotation_id": {
      "$ref": "#/$defs/nullableIdentifier"
    },
    "quotation_version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "status": {
      "enum": [
        "ACEPTADA",
        "RECHAZADA",
        "PROMESA_CONDICIONADA",
        "PENDIENTE"
      ]
    },
    "code": {
      "enum": [
        "VALIDADA",
        "DESCUENTO_SIN_APROBACION",
        "DISPONIBILIDAD_PARCIAL",
        "DEPENDENCIA_NO_DISPONIBLE",
        "CONTRATO_INVALIDO",
        "NO_AUTORIZADO",
        "IDEMPOTENCIA_CONFLICTO",
        "COTIZACION_YA_EVALUADA",
        "DATOS_INCONSISTENTES",
        "CLIENTE_NO_VALIDADO",
        "VERSION_OBSOLETA",
        "COTIZACION_NO_ENVIADA",
        "COTIZACION_VENCIDA",
        "ACEPTACION_INVALIDA",
        "PRECIO_INVALIDO",
        "CONTACTO_NO_AUTORIZADO",
        "CONDICIONES_POR_VALIDAR"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "responsible_role": {
      "enum": [
        "VENTAS",
        "GERENCIA",
        "ADMINISTRADOR_Y_VENTAS"
      ]
    },
    "required_action": {
      "type": "string",
      "minLength": 1
    },
    "total": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]+\\.[0-9]{2}(?![\\s\\S])"
    },
    "currency": {
      "enum": [
        "PEN",
        null
      ]
    },
    "order_id": {
      "$ref": "#/$defs/nullableIdentifier"
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sku",
          "requested_quantity",
          "available_quantity",
          "promised_date",
          "requires_customer_acceptance",
          "pending_quantity",
          "delivery_mode",
          "location_id",
          "requested_date"
        ],
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1
          },
          "requested_quantity": {
            "type": "integer",
            "minimum": 1
          },
          "available_quantity": {
            "type": "integer",
            "minimum": 0
          },
          "promised_date": {
            "type": "null"
          },
          "requires_customer_acceptance": {
            "const": true
          },
          "pending_quantity": {
            "type": "integer",
            "minimum": 1
          },
          "delivery_mode": {
            "const": "RECOJO_LOCAL"
          },
          "location_id": {
            "type": "string",
            "minLength": 1
          },
          "requested_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "response_id": {
      "$ref": "#/$defs/nullableIdentifier"
    },
    "order_state": {
      "enum": [
        "NO_CONFIRMADO",
        "CONFIRMADO"
      ]
    },
    "follow_up_state": {
      "enum": [
        "SIN_TAREA",
        "PENDIENTE_APROBACION",
        "NEGOCIAR_PROMESA",
        "RECUPERAR_SERVICIO",
        "CORREGIR_DATOS",
        "REVISAR_ACCESO",
        "CONSULTAR_ORIGINAL"
      ]
    },
    "attention_due_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ACEPTADA"
          }
        }
      },
      "then": {
        "properties": {
          "code": {
            "const": "VALIDADA"
          },
          "total": {
            "type": "string"
          },
          "currency": {
            "const": "PEN"
          },
          "conditions": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "PROMESA_CONDICIONADA"
          }
        }
      },
      "then": {
        "properties": {
          "code": {
            "const": "DISPONIBILIDAD_PARCIAL"
          },
          "total": {
            "type": "string"
          },
          "currency": {
            "const": "PEN"
          },
          "conditions": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "PENDIENTE"
          }
        }
      },
      "then": {
        "properties": {
          "code": {
            "const": "DEPENDENCIA_NO_DISPONIBLE"
          },
          "conditions": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "RECHAZADA"
          }
        }
      },
      "then": {
        "properties": {
          "code": {
            "not": {
              "enum": [
                "VALIDADA",
                "DISPONIBILIDAD_PARCIAL",
                "DEPENDENCIA_NO_DISPONIBLE"
              ]
            }
          },
          "conditions": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "not": {
              "const": "CONTRATO_INVALIDO"
            }
          }
        }
      },
      "then": {
        "properties": {
          "request_id": {
            "type": "string"
          },
          "correlation_id": {
            "type": "string"
          },
          "quotation_id": {
            "type": "string"
          },
          "quotation_version": {
            "type": "integer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "order_state": {
            "const": "CONFIRMADO"
          }
        }
      },
      "then": {
        "properties": {
          "order_id": {
            "type": "string"
          },
          "status": {
            "const": "ACEPTADA"
          }
        }
      },
      "else": {
        "properties": {
          "order_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ACEPTADA"
          }
        }
      },
      "then": {
        "properties": {
          "attention_due_at": {
            "type": "null"
          },
          "follow_up_state": {
            "const": "SIN_TAREA"
          }
        }
      },
      "else": {
        "properties": {
          "attention_due_at": {
            "type": "string"
          },
          "follow_up_state": {
            "not": {
              "const": "SIN_TAREA"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "CONTRATO_INVALIDO"
          }
        }
      },
      "then": {
        "properties": {
          "response_id": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "response_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "DESCUENTO_SIN_APROBACION"
          }
        }
      },
      "then": {
        "properties": {
          "responsible_role": {
            "const": "GERENCIA"
          },
          "follow_up_state": {
            "const": "PENDIENTE_APROBACION"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "PROMESA_CONDICIONADA"
          }
        }
      },
      "then": {
        "properties": {
          "follow_up_state": {
            "const": "NEGOCIAR_PROMESA"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "PENDIENTE"
          }
        }
      },
      "then": {
        "properties": {
          "follow_up_state": {
            "const": "RECUPERAR_SERVICIO"
          }
        }
      }
    }
  ],
  "$defs": {
    "nullableIdentifier": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])"
    }
  }
}
